<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_flasho" model="ir.ui.view">
        <field name="name">res.partner.form.flasho</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Flasho" name="flasho">
                    <group>
                        <field name="flasho_latitude"/>
                        <field name="flasho_longitude"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
